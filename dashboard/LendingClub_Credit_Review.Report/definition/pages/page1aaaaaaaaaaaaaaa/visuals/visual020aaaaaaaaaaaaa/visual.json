    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Recommendations",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontWeight": "bold",
                      "color": "#111827",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1. Stop E-G loans with DTI of 20+ or 2+ recent inquiries. ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#111827",
                      "fontFamily": "Segoe UI"
                    }
                  },
                  {
                    "value": "In the 2015 test they lost 0.2% and held 6.6% of bad loans. The rule only adds 0.2 points to the total, so it is a clean-up, not the fix.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "normal",
                      "color": "#111827",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2. Reprice E-G and D first. ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#111827",
                      "fontFamily": "Segoe UI"
                    }
                  },
                  {
                    "value": "E-G needed about 24.5% on 2015 loans to match grade A, against 19.8% charged. That is a minimum, because higher rates can draw weaker borrowers.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "normal",
                      "color": "#111827",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3. Add a 12-month vintage trigger. ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#111827",
                      "fontFamily": "Segoe UI"
                    }
                  },
                  {
                    "value": "By month 12, 2015 E-G loans were at 16.3% against 10.6% for 2013. That signal came well before the loans finished.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "normal",
                      "color": "#111827",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
