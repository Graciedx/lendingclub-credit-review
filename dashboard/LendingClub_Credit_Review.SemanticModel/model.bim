       "type": "m",
       "expression": [
        "let",
        "    Source = Csv.Document(File.Contents(DataFolder & \"mart_grade_vintage.csv\"),[Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
        "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
        "    Typed = Table.TransformColumnTypes(Promoted, {{\"grade_group\", type text}, {\"vintage\", Int64.Type}, {\"loans\", Int64.Type}, {\"funded_musd\", type number}, {\"avg_rate_pct\", type number}, {\"default_rate_pct\", type number}, {\"total_return_pct\", type number}, {\"net_gain_musd\", type number}}, \"en-GB\")",
        "in",
