      "dataType": "int64",
      "sourceColumn": "bad_loans",
      "summarizeBy": "none"
     },
     {
      "name": "net_gain",
      "dataType": "double",
      "sourceColumn": "net_gain",
      "summarizeBy": "none"
     }
    ],
    "partitions": [
     {
      "name": "mart_drivers",
      "mode": "import",
      "source": {
       "type": "m",
       "expression": [
        "let",
        "    Source = Csv.Document(File.Contents(DataFolder & \"mart_drivers.csv\"),[Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
        "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
        "    Typed = Table.TransformColumnTypes(Promoted, {{\"driver\", type text}, {\"band\", type text}, {\"grade_group\", type text}, {\"vintage\", Int64.Type}, {\"loans\", Int64.Type}, {\"funded\", type number}, {\"bad_loans\", Int64.Type}, {\"net_gain\", type number}}, \"en-GB\")",
        "in",
        "    Typed"
       ]
      }
     }
    ],
    "measures": [
     {
      "name": "Default rate",
      "expression": "DIVIDE(SUM(mart_drivers[bad_loans]),SUM(mart_drivers[loans]))",
      "formatString": "0.0%"
     },
     {
      "name": "Total return",
      "expression": "DIVIDE(SUM(mart_drivers[net_gain]),SUM(mart_drivers[funded]))",
      "formatString": "0.0%"
     }
    ]
   },
