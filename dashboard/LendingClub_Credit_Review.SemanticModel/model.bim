{
 "compatibilityLevel": 1550,
 "model": {
  "culture": "en-GB",
  "dataAccessOptions": {
   "legacyRedirects": true,
   "returnErrorValuesAsNull": true
  },
  "defaultPowerBIDataSourceVersion": "powerBI_V3",
  "sourceQueryCulture": "en-GB",
  "tables": [
   {
    "name": "mart_vintage",
    "columns": [
     {
      "name": "vintage",
      "dataType": "int64",
      "sourceColumn": "vintage",
      "summarizeBy": "none"
     },
     {
      "name": "loans",
      "dataType": "int64",
      "sourceColumn": "loans",
      "summarizeBy": "none"
     },
     {
      "name": "funded_musd",
      "dataType": "double",
      "sourceColumn": "funded_musd",
      "summarizeBy": "none"
     },
     {
      "name": "avg_rate_pct",
      "dataType": "double",
      "sourceColumn": "avg_rate_pct",
      "summarizeBy": "none"
     },
     {
      "name": "default_rate_pct",
      "dataType": "double",
      "sourceColumn": "default_rate_pct",
      "summarizeBy": "none"
     },
     {
      "name": "total_return_pct",
      "dataType": "double",
      "sourceColumn": "total_return_pct",
      "summarizeBy": "none"
     },
     {
      "name": "net_gain_musd",
      "dataType": "double",
      "sourceColumn": "net_gain_musd",
      "summarizeBy": "none"
     }
    ],
    "partitions": [
     {
      "name": "mart_vintage",
      "mode": "import",
      "source": {
       "type": "m",
       "expression": [
        "let",
        "    Source = Csv.Document(File.Contents(DataFolder & \"mart_vintage.csv\"),[Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
        "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
        "    Typed = Table.TransformColumnTypes(Promoted, {{\"vintage\", Int64.Type}, {\"loans\", Int64.Type}, {\"funded_musd\", type number}, {\"avg_rate_pct\", type number}, {\"default_rate_pct\", type number}, {\"total_return_pct\", type number}, {\"net_gain_musd\", type number}}, \"en-GB\")",
        "in",
        "    Typed"
       ]
      }
     }
    ],
    "measures": [
     {
      "name": "Return 2012",
      "expression": "CALCULATE(SUM(mart_vintage[total_return_pct]),mart_vintage[vintage]=2012)/100",
      "formatString": "0.0%"
     },
     {
      "name": "Return 2015",
      "expression": "CALCULATE(SUM(mart_vintage[total_return_pct]),mart_vintage[vintage]=2015)/100",
      "formatString": "0.0%"
     },
     {
      "name": "Default rate 2015",
      "expression": "CALCULATE(SUM(mart_vintage[default_rate_pct]),mart_vintage[vintage]=2015)/100",
      "formatString": "0.0%"
     },
     {
      "name": "Default rate 2013",
      "expression": "CALCULATE(SUM(mart_vintage[default_rate_pct]),mart_vintage[vintage]=2013)/100",
      "formatString": "0.0%"
     },
     {
      "name": "Loans analysed",
      "expression": "SUM(mart_vintage[loans])",
      "formatString": "#,0"
     },
     {
      "name": "Funded",
      "expression": "SUM(mart_vintage[funded_musd])/1000",
      "formatString": "$0.00\"bn\""
     }
    ]
   },
   {
