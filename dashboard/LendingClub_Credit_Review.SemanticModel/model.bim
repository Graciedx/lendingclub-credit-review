   {
    "name": "mart_drivers",
    "columns": [
     {
      "name": "driver",
      "dataType": "string",
      "sourceColumn": "driver",
      "summarizeBy": "none"
     },
     {
      "name": "band",
      "dataType": "string",
      "sourceColumn": "band",
      "summarizeBy": "none"
     },
     {
      "name": "grade_group",
      "dataType": "string",
      "sourceColumn": "grade_group",
      "summarizeBy": "none"
     },
     {
      "name": "vintage",
      "dataType": "int64",
      "sourceColumn": "vintage",
      "summarizeBy": "none"
     },
     {
      "name": "loans",
